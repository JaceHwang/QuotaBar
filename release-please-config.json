{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "component": "codex-usage-sidebar",
      "extra-files": [
        {
          "type": "generic",
          "path": "version.txt"
        },
        {
          "type": "xml",
          "path": "plugins/codex-usage-sidebar/windows/Directory.Build.props",
          "xpath": "//VersionPrefix"
        }
      ]
    }
  }
}
